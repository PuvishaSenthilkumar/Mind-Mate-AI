# --- Database ---
DATABASE_URL=postgresql://mindmate_user:mindmate_pass@localhost:5432/mindmate_db

# --- Auth / JWT ---
JWT_SECRET_KEY=replace_this_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Provider ---
# Supported values: gemini | anthropic | openai | mock
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- App ---
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development

# --- Safety / Crisis Resources (configurable, shown in-app) ---
CRISIS_HOTLINE_NAME=Global crisis support
CRISIS_HOTLINE_NUMBER=Use local emergency services
CRISIS_TEXT_LINE=Use a local crisis text service if available
CRISIS_INTERNATIONAL_URL=https://findahelpline.com

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=MindMate AI
EMAIL_OTP_EXPIRE_MINUTES=15
